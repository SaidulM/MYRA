# ============================================
#  MYRA — private laptop settings
#  Copy this file and rename the copy to: .env
#  Paste your own free API keys only on your laptop.
#  WARNING: never upload real keys to GitHub.
#  (.env is already listed in .gitignore)
# ============================================

# --- AI Brain API keys (save at least one, or set an Ollama model) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- AI model choices ---
# auto = MYRA picks a working model for the saved key where supported.
GEMINI_MODEL=auto
GROQ_MODEL=auto
OPENROUTER_MODEL=auto
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-small-latest

# --- Ollama Local PC (free/offline after you install Ollama + a model) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Answer length ---
# auto   = short answer by default; detailed only when you ask for more
# short  = prefer short answers unless you explicitly ask for detail
# detailed = prefer detailed answers unless you explicitly ask for short
MYRA_RESPONSE_STYLE=auto

# --- Local MYRA backend ---
# 127.0.0.1 means only this laptop can reach MYRA (recommended).
MYRA_HOST=127.0.0.1
MYRA_PORT=8765

# Optional token for Core API (/api/v1/...) calls from OTHER devices/apps.
# Leave empty for the normal desktop app — MYRA's own screen on this laptop
# keeps working either way. This token does NOT password-protect the whole
# web page, so keep MYRA_HOST=127.0.0.1 unless you deliberately use trusted
# home Wi-Fi only.
MYRA_API_TOKEN=

# Optional advanced HTTPS for the local backend. Leave empty for the
# normal desktop app: 127.0.0.1 stays inside this laptop. If both files
# are set, MYRA serves HTTPS with that certificate/key pair.
MYRA_TLS_CERT_FILE=
MYRA_TLS_KEY_FILE=

# Secret storage: auto uses Windows Credential Manager when available;
# env forces the private .env fallback.
MYRA_SECRET_STORE=auto

# Browser Agent visibility (0 = visible/recommended, 1 = headless)
MYRA_BROWSER_HEADLESS=0
