# ============================================
#  MYRA — API key configuration
#  Copy this file, rename the copy to: .env
#  Then paste your own free API keys.
#  WARNING: never upload real keys to GitHub
#  (.env is already listed in .gitignore)
# ============================================

# Gemini API key (primary) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key (backup / fallback) — https://console.groq.com/keys
GROQ_API_KEY=

# Optional AI model overrides (usually leave these commented out)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Server settings (usually no need to change)
MYRA_HOST=127.0.0.1
MYRA_PORT=8765
