# ============================================
#  Stonic AI — API Key কনফিগারেশন
#  এই ফাইলের কপি বানিয়ে নাম দাও: .env
#  তারপর নিজের ফ্রি API key বসাও।
#  ⚠️ আসল key কখনো GitHub-এ আপলোড করাবে না (.env gitignore করা আছে)
# ============================================

# Gemini API Key (প্রাইমারি) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key (ব্যাকআপ/ফলব্যাক) — https://console.groq.com/keys
GROQ_API_KEY=

# সার্ভার সেটিংস (বদলানোর দরকার নেই সাধারণত)
STONIC_HOST=127.0.0.1
STONIC_PORT=8765
